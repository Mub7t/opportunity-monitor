# ──────────────────────────────────────────────────────────────────────────────
# Bahr Monitor v3 — Environment Variables
# Copy to ".env" for local use. Add as GitHub Secrets for Actions.
# ──────────────────────────────────────────────────────────────────────────────

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECEIVER=your_email@gmail.com

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=your_chat_id

# ── AI Analysis ────────────────────────────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai              # openai | anthropic
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=gpt-4o-mini

# ── Notification tiers ────────────────────────────────────────────────────────
MIN_NOTIFY_SCORE=60             # 🟡 Normal Telegram alert
HIGH_PRIORITY_SCORE=75          # 🔴 High Priority alert
GOLDEN_SCORE=90                 # 🥇 Golden badge in email
GOLDEN_MIN_SCORE=85             # Min composite for Golden classification
GOLDEN_MIN_WIN_PCT=50           # Min win probability for Golden
GOLDEN_PROFITABILITY=high       # Required profitability for Golden

# ── Scraping ───────────────────────────────────────────────────────────────────
MAX_SCROLL_STEPS=8
SCRAPE_MAX_RETRIES=3
SCRAPE_RETRY_DELAY_S=15
AI_MAX_RETRIES=2
RATE_LIMIT_DELAY_S=1.0
SIMILARITY_THRESHOLD=0.55

# ── Dashboard (run manually: python dashboard.py) ────────────────────────────
DASHBOARD_ENABLED=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# ── Market Intelligence ────────────────────────────────────────────────────────
MARKET_REPORT_DAY=0             # 0=Monday, 6=Sunday

# ── User Profile (Mubarak) ────────────────────────────────────────────────────
PROFILE_NAME=مبارك
PROFILE_TITLE=مطور ويب ومصور محترف
PROFILE_SKILLS=تصوير، فيديو، موشن جرافيك، تصميم جرافيك، تطوير ويب، ذكاء اصطناعي، أتمتة، استشارات تقنية
PROFILE_EXPERIENCE=5+ سنوات
PROFILE_PORTFOLIO=https://your-portfolio.com
PROFILE_CONTACT=your@email.com
